{
  "manifest_version": 3,
  "name": "ChatSweeper",
  "short_name": "ChatSweeper",
  "version": "0.1.1",
  "description": "Select. Manage. Keep or Sweep. Find, protect and delete Gemini and ChatGPT chats with visible progress.",
  "author": "Mikaela Marie Punzalan",
  "homepage_url": "https://github.com/okmikaelaok/chat-sweeper",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "ChatSweeper — Select. Manage. Keep or Sweep.",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "dates.js",
        "sites.js",
        "protection.js",
        "ui.js",
        "theme.js",
        "dialogs.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
